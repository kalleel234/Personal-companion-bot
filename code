void setDefaultConfig() {
  memset(&cfg, 0, sizeof(cfg));
  cfg.autoLocation = 1;
  cfg.lat = 13.0827f;
  cfg.lon = 80.2707f;
}

void loadConfig() {
  EEPROM.begin(512);
  EEPROM.get(0, cfg);
  EEPROM.end();

  if (cfg.magic != CFG_MAGIC) {
    setDefaultConfig();
    cfgValid = false;
    return;
  }

  cfg.ssid[sizeof(cfg.ssid) - 1] = 0;
  cfg.pass[sizeof(cfg.pass) - 1] = 0;
  cfg.city[sizeof(cfg.city) - 1] = 0;

  if (isnan(cfg.lat) || isnan(cfg.lon) ||
      cfg.lat < -90 || cfg.lat > 90 || cfg.lon < -180 || cfg.lon > 180) {
    cfg.lat = 13.0827f;
    cfg.lon = 80.2707f;
  }

  cfgValid = cfg.ssid[0] != 0;

  wxLat = cfg.lat;
  wxLon = cfg.lon;
  cityName = cfg.city;
}

void saveConfig() {
  cfg.magic = CFG_MAGIC;
  EEPROM.begin(512);
  EEPROM.put(0, cfg);
  EEPROM.commit();
  EEPROM.end();
  Serial.println(F("Config saved."));
}

bool takePortalFlag() {
  uint32_t flag = 0;
  ESP.rtcUserMemoryRead(0, &flag, sizeof(flag));
  if (flag != RTC_PORTAL_FLAG) return false;
  flag = 0;
  ESP.rtcUserMemoryWrite(0, &flag, sizeof(flag));
  return true;
}

void requestPortal() {
  uint32_t flag = RTC_PORTAL_FLAG;
  ESP.rtcUserMemoryWrite(0, &flag, sizeof(flag));
  showMessage("Setup", "Opening Wi-Fi", "setup mode...", "", 3000);
  restartAt = millis() + 1200;
  Serial.println(F("Restarting into setup mode."));
}


