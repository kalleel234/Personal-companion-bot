}

void openWeather() {
  mood = MOOD_NORMAL;
  screen = SCR_WEATHER;
  pageStart = millis();
  Serial.println(F("SCREEN: weather"));
}

void openMenu() {
  mood = MOOD_NORMAL;
  screen = SCR_MENU;
  menuArmed = false;
  menuHoldFired = false;
  menuLastTouch = millis();
  lastFrame = 0;   // draw right away
  Serial.println(F("SCREEN: setup menu"));
}

void backToEyes() {
  screen = SCR_EYES;
  Serial.println(F("SCREEN: eyes"));
}

void showMessage(const String& title, const String& l1, const String& l2,
                 const String& l3, unsigned long ms) {
  msgTitle = title;
  msgLine1 = l1;
  msgLine2 = l2;
  msgLine3 = l3;
  msgUntil = millis() + ms;
  screen = SCR_MESSAGE;
  lastFrame = 0;   // draw right away
}

void updateTimers() {
  if (mood != MOOD_NORMAL && timeReached(moodUntil)) {
    mood = MOOD_NORMAL;
    Serial.println(F("MOOD: normal"));
  }

  if (screen == SCR_TIME && millis() - pageStart >= TIME_PAGE_MS) {
    openWeather();
  } else if (screen == SCR_WEATHER && millis() - pageStart >= WEATHER_PAGE_MS) {
    backToEyes();
  } else if (screen == SCR_MENU && millis() - menuLastTouch >= MENU_TIMEOUT_MS) {
    backToEyes();
  } else if (screen == SCR_MESSAGE && timeReached(msgUntil)) {
    backToEyes();
  }
}


// ============================================================
// TOUCH
// ============================================================

// Taps on the face
void onTaps(int n) {
  Serial.print(F("TAPS: "));
  Serial.println(n);

  if (n == 1)      setMood(MOOD_NORMAL);   // normal smile
  else if (n == 2) setMood(MOOD_HAPPY);    // very happy
  else if (n == 3) setMood(MOOD_SAD);      // emotional sad
  else if (n <= 5) setMood(MOOD_ANGRY);    // 4 taps (5 counts as 4)
  else             openMenu();             // 6 taps: setup menu
}

// A tap on any other screen
void onPageTap() {
  if (screen == SCR_TIME) openWeather();   // next page
  else backToEyes();                       // weather / menu / message
}

void handleTouch() {
  if (restartAt != 0) return;   // restarting: ignore the sensor

  unsigned long now = millis();
  bool raw = digitalRead(TOUCH_PIN) == TOUCH_ACTIVE;

  if (raw != rawLast) {
    rawLast = raw;
    rawChangeAt = now;
  }

  // Debounced edge
  if (raw != touchState && now - rawChangeAt >= DEBOUNCE_MS) {
    touchState = raw;

    if (touchState) {
      pressStart = now;
      longFired = false;
      setupFired = false;
      if (screen == SCR_MENU) menuArmed = true;
    } else {
      unsigned long held = now - pressStart;

      if (!longFired && held <= TAP_MAX_MS) {
        if (screen == SCR_EYES) {
          tapCount++;
          lastRelease = now;
          boopStart = now;            // little squish on every tap
        } else {
          tapCount = 0;
          onPageTap();
        }
      } else {
        tapCount = 0;                 // a hold is not a tap
      }
    }
  }

  // Holding
  if (touchState) {
    unsigned long held = now - pressStart;

    if (screen == SCR_MENU) {
      menuLastTouch = now;

      // menuArmed: the hold that opened the menu does not count
      if (menuArmed && !menuHoldFired && held >= MENU_WIFI_HOLD_MS) {
        menuHoldFired = true;
        requestPortal();
      }
    } else {
      if (!longFired && held >= HOLD_INFO_MS) {
        longFired = true;
        tapCount = 0;
        Serial.println(F("HOLD 5 SEC"));
        if (screen == SCR_EYES || screen == SCR_MESSAGE) openInfo();
      }

      if (!setupFired && held >= HOLD_MENU_MS) {
        setupFired = true;
        Serial.println(F("HOLD 10 SEC"));
        openMenu();
      }
    }
  }

  // Tap series finished
  if (!touchState && tapCount > 0 && now - lastRelease >= TAP_WINDOW_MS) {
    onTaps(tapCount);
    tapCount = 0;
  }
}


