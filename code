  unsigned long now = millis();
  mood = m;
  moodStart = now;

  moodUntil = now + MOOD_MS;   // then back to the normal smile

  if (screen != SCR_PORTAL) screen = SCR_EYES;

  Serial.print(F("MOOD: "));
