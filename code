// ============================================================
// WEB HANDLERS - SETUP PORTAL
// ============================================================

void doScan() {
  Serial.println(F("Scanning Wi-Fi..."));
  scanCount = WiFi.scanNetworks();
  if (scanCount < 0) scanCount = 0;
  Serial.print(scanCount);
  Serial.println(F(" networks found."));
}

void handlePortalRoot() {
  portalLastActivity = millis();
  server.send_P(200, "text/html; charset=utf-8", PAGE_SETUP);
}

void handleNetworks() {
  portalLastActivity = millis();
  if (server.hasArg("rescan") || scanCount < 0) doScan();

  String json = "[";
  for (int i = 0; i < scanCount; i++) {
    if (i) json += ',';
    json += F("{\"ssid\":\"");
    json += jsonEscape(WiFi.SSID(i));
    json += F("\",\"rssi\":");
    json += WiFi.RSSI(i);
    json += F(",\"lock\":");
    json += (WiFi.encryptionType(i) == ENC_TYPE_NONE) ? "false" : "true";
    json += '}';
  }
  json += ']';

  server.send(200, "application/json", json);
}

void handleSave() {
  portalLastActivity = millis();

  String ssid = server.arg("ssid");
  String pass = server.arg("pass");
  ssid.trim();

  if (ssid.length() == 0 || ssid.length() > 32 || pass.length() > 64) {
    server.send(400, "text/html; charset=utf-8",
                F("<p style='font-family:sans-serif;padding:30px'>Please check the Wi-Fi name and password. <a href='/'>Back</a></p>"));
    return;
  }

  memset(cfg.ssid, 0, sizeof(cfg.ssid));
  memset(cfg.pass, 0, sizeof(cfg.pass));
  ssid.toCharArray(cfg.ssid, sizeof(cfg.ssid));
  pass.toCharArray(cfg.pass, sizeof(cfg.pass));

  // Place for the weather: a town name is looked up once Shuri is online
  String city = server.arg("city");
  city.trim();

  if (city.length()) {
    cfg.autoLocation = 2;                 // 2 = look this name up
    memset(cfg.city, 0, sizeof(cfg.city));
    city.toCharArray(cfg.city, sizeof(cfg.city));
  } else if (!cfgValid) {
    cfg.autoLocation = 1;                 // 1 = rough guess from the internet
  }                                       // otherwise keep the saved place

  saveConfig();

  String page = F("<!DOCTYPE html><html><head><meta charset='utf-8'>"
                  "<meta name='viewport' content='width=device-width,initial-scale=1'></head>"
                  "<body style='margin:0;font-family:system-ui,sans-serif;background:#150b24;color:#fff;"
                  "text-align:center;padding:40px 22px'>"
                  "<h1 style='letter-spacing:8px'>SHURI</h1>"
                  "<p style='font-size:40px;margin:10px'>&#9829;</p>"
                  "<p>Saved! I'm restarting and joining <b>");
  page += htmlEscape(ssid);
  page += F("</b>.</p><p style='opacity:.7;line-height:1.6'>Now connect your phone back to that same Wi-Fi.<br>"
            "My screen will show my address (like 192.168.1.23).<br>Open it in your browser to play with me.</p>"
            "</body></html>");

  server.send(200, "text/html; charset=utf-8", page);

  showMessage("Saved!", "Joining Wi-Fi:", fitText(ssid, 21), "restarting...", 5000);
  restartAt = millis() + 2000;
}

void handlePortalRedirect() {
  portalLastActivity = millis();
  server.sendHeader("Location", "http://192.168.4.1/", true);
  server.send(302, "text/plain", "");
}


// ============================================================
// WEB HANDLERS - DASHBOARD
// ============================================================

void handleDashRoot() {
  server.send_P(200, "text/html; charset=utf-8", PAGE_DASH);
}

void handleStatus() {
  String j;
  j.reserve(560);

  j += F("{\"mood\":\"");
  j += moodName(mood);
  j += F("\",\"screen\":\"");
  j += screenName(screen);
  j += '"';

  struct tm t;
  bool synced = getTimeNow(t);
  j += F(",\"synced\":");
  j += synced ? "true" : "false";

  if (synced) {
    int h12 = t.tm_hour % 12;
    if (h12 == 0) h12 = 12;
    char buf[40];
    snprintf(buf, sizeof(buf), "%d:%02d %s", h12, t.tm_min, t.tm_hour < 12 ? "AM" : "PM");
    j += F(",\"time\":\"");
    j += buf;
    snprintf(buf, sizeof(buf), "%s, %d %s %d", DAY_NAMES[t.tm_wday], t.tm_mday,
             MONTH_NAMES[t.tm_mon], t.tm_year + 1900);
    j += F("\",\"date\":\"");
    j += buf;
    j += '"';
  }

  j += F(",\"wx\":");
  j += weatherOk ? "true" : "false";
  if (weatherOk) {
    j += F(",\"temp\":");  j += String(wxTemp, 1);
    j += F(",\"hum\":");   j += String(wxHum, 0);
    j += F(",\"wind\":");  j += String(wxWind, 1);
    j += F(",\"cond\":\""); j += weatherText(wxCode);
    j += F("\",\"city\":\""); j += jsonEscape(cityName);
    j += '"';
  }

  j += F(",\"place\":\"");
  j += jsonEscape(placeText());
  j += F("\",\"guess\":");
  j += (cfg.autoLocation != 0) ? "true" : "false";

  j += F(",\"ssid\":\"");
  j += jsonEscape(WiFi.SSID());
  j += F("\",\"ip\":\"");
  j += ipString();
  j += F("\",\"rssi\":");
  j += WiFi.RSSI();
  j += '}';

  server.send(200, "application/json", j);
}

void handleDo() {
  String a = server.arg("a");

  if (a == "happy")        setMood(MOOD_HAPPY);
  else if (a == "sad")     setMood(MOOD_SAD);
  else if (a == "angry")   setMood(MOOD_ANGRY);
  else if (a == "normal")  setMood(MOOD_NORMAL);
  else if (a == "info" || a == "time") openInfo();
  else if (a == "weather") openWeather();
  else if (a == "askloc") {
    // the phone page is asking the phone for its GPS position
    showMessage("LOCATION", "Turn on your", "mobile location", "(GPS) on your phone", 8000);
  }
  else {
    server.send(400, "application/json", F("{\"ok\":false}"));
    return;
  }

  boopStart = millis();
  server.send(200, "application/json", F("{\"ok\":true}"));
}

// The exact place for the weather. Saved, and used until it is changed.
void setLocation(float la, float lo, const String& name, bool announce) {
  wxLat = la;
  wxLon = lo;
  cityName = name;

  cfg.autoLocation = 0;                   // 0 = fixed place
  cfg.lat = la;
  cfg.lon = lo;
  memset(cfg.city, 0, sizeof(cfg.city));
  name.toCharArray(cfg.city, sizeof(cfg.city));
  saveConfig();

  weatherOk = false;                      // old reading was for another place
  nextWeatherAt = millis();

  Serial.print(F("Location set: "));
  Serial.println(placeText());

  if (announce) showMessage("Location", "Saved:", fitText(placeText(), 21), "", 4000);
}

// POST /api/setloc?lat=..&lon=..&name=..
void handleSetLoc() {
  String latS = server.arg("lat");
  String lonS = server.arg("lon");
  String name = server.arg("name");
  name.trim();

  float la = latS.toFloat();
  float lo = lonS.toFloat();

  bool ok = latS.length() && lonS.length() &&
            la >= -90 && la <= 90 && lo >= -180 && lo <= 180;

  if (!ok) {
    server.send(400, "application/json", F("{\"ok\":false}"));
    return;
  }

  setLocation(la, lo, name, true);
  server.send(200, "application/json", F("{\"ok\":true}"));
}

// GET /api/findcity?q=..  (used when the phone cannot search by itself)
void handleFindCity() {
  String q = server.arg("q");
  q.trim();

  float la, lo;
  String name, list = "[]";

  if (wifiUp && q.length() >= 2) findPlace(q, 5, la, lo, name, list);

  server.send(200, "application/json", list);
}

void handleSetupRequest() {
  server.send(200, "application/json", F("{\"ok\":true}"));
  requestPortal();
}


// ============================================================
// WI-FI
// ============================================================

String ipString() {
  return WiFi.localIP().toString();
}

void startPortal() {
  portalMode = true;
  screen = SCR_PORTAL;

  Serial.println();
  Serial.println(F("==== SHURI SETUP MODE ===="));

  WiFi.setAutoReconnect(false);
  WiFi.disconnect();
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAPConfig(AP_IP, AP_IP, IPAddress(255, 255, 255, 0));
  WiFi.softAP(AP_NAME, AP_PASS);

  dnsServer.setErrorReplyCode(DNSReplyCode::NoError);
  dnsServer.start(53, "*", AP_IP);

  drawPortalPage();
  display.display();
  doScan();

  server.on("/", HTTP_GET, handlePortalRoot);
  server.on("/networks", HTTP_GET, handleNetworks);
  server.on("/save", HTTP_POST, handleSave);
  server.onNotFound(handlePortalRedirect);   // captive portal pop-up
  server.begin();

  portalLastActivity = millis();

  Serial.print(F("AP: "));
  Serial.print(AP_NAME);
  Serial.print(F("  pass: "));
  Serial.println(AP_PASS);
  Serial.println(F("Open http://192.168.4.1"));
}

bool connectAtBoot() {
  Serial.print(F("Connecting to "));
  Serial.println(cfg.ssid);

  WiFi.mode(WIFI_STA);
  WiFi.hostname(HOST_NAME);
  WiFi.setAutoReconnect(true);
  WiFi.begin(cfg.ssid, cfg.pass);

  unsigned long start = millis();
  lookOverride = true;
  showMouth = false;          // the bottom line shows the Wi-Fi name
  wakeStart = start;

  String label = fitText(String("Finding ") + cfg.ssid, 21);

  while (WiFi.status() != WL_CONNECTED && millis() - start < WIFI_BOOT_TIMEOUT_MS) {
    unsigned long now = millis();

    // eyes look left and right while searching
    lookTX = sinf(now * 0.0025f);
    lookTY = -0.3f;
    renderEyes(now);

    display.fillRect(0, 55, SCREEN_W, 9, C_OFF);
    display.setTextColor(C_ON);
    drawCenteredText(label, 1, 56);
    display.display();

    delay(30);
  }

  lookOverride = false;
  showMouth = true;
  lookTX = 0;
  lookTY = 0;
  lastWiFiKick = millis();

  return WiFi.status() == WL_CONNECTED;
}

void onWiFiUp() {
  Serial.print(F("Wi-Fi connected. IP: "));
  Serial.println(ipString());

  if (!mdnsStarted && MDNS.begin(HOST_NAME)) {
    MDNS.addService("http", "tcp", 80);
    mdnsStarted = true;
    Serial.println(F("mDNS: http://shuri.local"));
  }

  configTime(utcOffsetSec, 0, "pool.ntp.org", "time.google.com");

  locationPending = true;
  nextWeatherAt = millis();

  if (!everConnected) {
    showMessage("Hi! I'm on", "Open on your phone:", "http://" + ipString(), "or shuri.local", 8000);
  }
  everConnected = true;
}

void handleWiFi() {
  bool up = WiFi.status() == WL_CONNECTED;

  if (up && !wifiUp) {
    wifiUp = true;
    onWiFiUp();
  } else if (!up && wifiUp) {
    wifiUp = false;
    lastWiFiKick = millis();
    Serial.println(F("Wi-Fi lost. Retrying in the background."));
  }

  // The ESP retries by itself; give it a fresh start once a minute
  if (!up && cfgValid && millis() - lastWiFiKick >= WIFI_RETRY_MS) {
    lastWiFiKick = millis();
    Serial.println(F("Retrying Wi-Fi..."));
    WiFi.begin(cfg.ssid, cfg.pass);
  }
}

// Network calls block for a moment, so only do them when Shuri is calm
bool isCalm() {
  return screen == SCR_EYES && mood == MOOD_NORMAL &&
         !touchState && tapCount == 0;
}

void handleNetTasks() {
  if (!wifiUp) return;
  if (!isCalm() && screen != SCR_MESSAGE) return;

  if (locationPending) {
    locationPending = false;
    fetchLocation();

    // A town name typed on the Wi-Fi setup page: look it up now
    if (cfg.autoLocation == 2) {
      float la, lo;
      String name, list;
      if (findPlace(cfg.city, 1, la, lo, name, list) > 0) {
        setLocation(la, lo, name, false);
      } else {
        Serial.println(F("Town not found yet. Using the internet guess."));
      }
    }
    return;
  }

  if (timeReached(nextWeatherAt)) {
    updateWeather();
  }
}


// ============================================================
// LOCATION (ip-api.com, no key needed)
// ============================================================

void fetchLocation() {
  Serial.println(F("Finding location..."));

  WiFiClient client;
  HTTPClient http;
  http.setTimeout(5000);

  if (!http.begin(client, "http://ip-api.com/json/?fields=status,city,lat,lon,offset")) {
    Serial.println(F("Location: begin failed"));
    return;
  }

  int code = http.GET();

  if (code == HTTP_CODE_OK) {
#if ARDUINOJSON_VERSION_MAJOR >= 7
    JsonDocument doc;
#else
    DynamicJsonDocument doc(512);
#endif
    DeserializationError err = deserializeJson(doc, http.getStream());

    if (!err && String((const char*)(doc["status"] | "")) == "success") {
      long off = doc["offset"] | 19800L;
      if (off != utcOffsetSec) {
        utcOffsetSec = off;
        configTime(utcOffsetSec, 0, "pool.ntp.org", "time.google.com");
      }

      if (cfg.autoLocation) {
        wxLat = doc["lat"] | wxLat;
        wxLon = doc["lon"] | wxLon;
        cityName = (const char*)(doc["city"] | "");
      }

      Serial.print(F("Location: "));
      Serial.print(cityName);
      Serial.print(F("  "));
      Serial.print(wxLat, 4);
      Serial.print(F(", "));
      Serial.print(wxLon, 4);
      Serial.print(F("  UTC offset "));
      Serial.println(utcOffsetSec);
    } else {
      Serial.println(F("Location: bad reply"));
    }
  } else {
    Serial.print(F("Location HTTP error: "));
    Serial.println(code);
  }

  http.end();
}


// ============================================================
// PLACE SEARCH (open-meteo.com geocoding, no key needed)
// ============================================================

String urlEncode(const String& text) {
  String out;
  char buf[4];

  for (unsigned int i = 0; i < text.length(); i++) {
    uint8_t c = (uint8_t)text[i];
    if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
      out += (char)c;
    } else {
      snprintf(buf, sizeof(buf), "%%%02X", c);
      out += buf;
    }
  }

  return out;
}

// Looks a town name up. Fills the best match (lat, lon, name) and a small
// JSON list of all matches. Returns how many were found, -1 if no answer.
int findPlace(const String& query, int count, float& lat, float& lon,
              String& name, String& listJson) {
  String url = String(F("https://geocoding-api.open-meteo.com/v1/search?language=en&format=json&count=")) +
               String(count) + F("&name=") + urlEncode(query);

  Serial.print(F("Looking up place: "));
  Serial.println(query);

  BearSSL::WiFiClientSecure client;
  client.setInsecure();   // public place names only, no secrets

  HTTPClient http;
  http.useHTTP10(true);   // plain reply that can be read piece by piece
  http.setTimeout(8000);

  int found = -1;
  listJson = "[";

  if (http.begin(client, url)) {
    int code = http.GET();

    if (code == HTTP_CODE_OK) {
      // Keep only the few fields we need (the full reply can be large)
#if ARDUINOJSON_VERSION_MAJOR >= 7
      JsonDocument filter;
      JsonDocument doc;
#else
      StaticJsonDocument<256> filter;
      DynamicJsonDocument doc(2048);
#endif
      filter["results"][0]["name"] = true;
      filter["results"][0]["latitude"] = true;
      filter["results"][0]["longitude"] = true;
      filter["results"][0]["admin1"] = true;
      filter["results"][0]["country"] = true;

      DeserializationError err = deserializeJson(doc, http.getStream(),
                                                 DeserializationOption::Filter(filter));

      if (!err) {
        found = 0;

        for (JsonObject r : doc["results"].as<JsonArray>()) {
          const char* n = r["name"] | "";
          if (!n[0]) continue;

          float la = r["latitude"] | 0.0f;
          float lo = r["longitude"] | 0.0f;

          String area = (const char*)(r["admin1"] | "");
          const char* country = r["country"] | "";
          if (country[0]) {
            if (area.length()) area += ", ";
            area += country;
          }

          if (found == 0) {
            lat = la;
            lon = lo;
            name = n;
          } else {
            listJson += ',';
          }

          listJson += F("{\"name\":\"");
          listJson += jsonEscape(n);
          listJson += F("\",\"area\":\"");
          listJson += jsonEscape(area);
          listJson += F("\",\"lat\":");
          listJson += String(la, 4);
          listJson += F(",\"lon\":");
          listJson += String(lo, 4);
          listJson += '}';

          found++;
        }
      } else {
        Serial.println(F("Place search: could not read the reply"));
      }
    } else {
      Serial.print(F("Place search HTTP error: "));
      Serial.println(code);
    }

    http.end();
  }

  listJson += ']';

  Serial.print(F("Places found: "));
  Serial.println(found);

  return found;
}


// ============================================================
// WEATHER (open-meteo.com, no key needed)
// ============================================================

void updateWeather() {
  nextWeatherAt = millis() + WEATHER_RETRY_MS;   // if this fails

  String url = String(F("https://api.open-meteo.com/v1/forecast?latitude=")) + String(wxLat, 4) +
               F("&longitude=") + String(wxLon, 4) +
               F("&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,is_day");

  Serial.println(F("Getting weather..."));

  BearSSL::WiFiClientSecure client;
  client.setInsecure();   // weather data only, no secrets

  HTTPClient http;
  http.setTimeout(8000);

  if (!http.begin(client, url)) {
    Serial.println(F("Weather: begin failed"));
    return;
  }

  int code = http.GET();

  if (code == HTTP_CODE_OK) {
    String payload = http.getString();

#if ARDUINOJSON_VERSION_MAJOR >= 7
    JsonDocument doc;
#else
    DynamicJsonDocument doc(1536);
#endif
    DeserializationError err = deserializeJson(doc, payload);

    if (!err && doc["current"].is<JsonObject>()) {
      JsonObject cur = doc["current"];
      wxTemp  = cur["temperature_2m"] | 0.0f;
      wxHum   = cur["relative_humidity_2m"] | 0.0f;
      wxWind  = cur["wind_speed_10m"] | 0.0f;
      wxCode  = cur["weather_code"] | -1;
      wxIsDay = (cur["is_day"] | 1) == 1;

      weatherOk = true;
      wxUpdatedAt = millis();
      nextWeatherAt = millis() + WEATHER_EVERY_MS;

      Serial.print(F("Weather: "));
      Serial.print(wxTemp, 1);
      Serial.print(F(" C, "));
      Serial.print(weatherText(wxCode));
      Serial.print(F(", humidity "));
      Serial.println(wxHum, 0);
    } else {
      Serial.println(F("Weather: JSON error"));
    }
  } else {
    Serial.print(F("Weather HTTP error: "));
    Serial.println(code);
  }

  http.end();
}


// ============================================================
// SETUP
// ============================================================

void showSplash() {
  display.clearDisplay();
  display.setTextColor(C_ON);
  drawCenteredText("SHURI", 3, 14);
  drawHeart(64, 50);
  display.display();
}

void setup() {
  Serial.begin(115200);
  delay(50);
  Serial.println();
  Serial.println(F("==== SHURI waking up ===="));

  pinMode(TOUCH_PIN, INPUT);

  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println(F("OLED not found! Check wiring / address 0x3C."));
    while (true) delay(1000);
  }

  randomSeed(RANDOM_REG32);

  showSplash();
  delay(1800);

  WiFi.persistent(false);   // we keep our own copy in EEPROM

  loadConfig();
  bool forcePortal = takePortalFlag();

  if (!cfgValid || forcePortal) {
    if (!cfgValid) Serial.println(F("No saved Wi-Fi."));
    startPortal();
    return;
  }

  // Normal mode: web dashboard is always available on the local Wi-Fi
  server.on("/", HTTP_GET, handleDashRoot);
  server.on("/api/status", HTTP_GET, handleStatus);
  server.on("/api/do", handleDo);
  server.on("/api/setloc", HTTP_POST, handleSetLoc);
  server.on("/api/findcity", HTTP_GET, handleFindCity);
  server.on("/api/setup", HTTP_POST, handleSetupRequest);
  server.onNotFound([]() { server.send(404, "text/plain", "Not found"); });
  server.begin();

  if (connectAtBoot()) {
    wifiUp = true;
    onWiFiUp();
  } else {
    Serial.println(F("Wi-Fi not found. Playing offline."));
    showMessage("Offline", String("Can't find ") + fitText(cfg.ssid, 11),
                "I'll keep trying :)", "6 taps = menu", 6000);
  }

  wakeStart = millis();
  nextBlinkAt = millis() + 1500;
}


// ============================================================
// LOOP
// ============================================================

void loop() {
  if (restartAt != 0 && timeReached(restartAt)) {
    ESP.restart();
  }

  if (portalMode) {
    dnsServer.processNextRequest();
    server.handleClient();

    // Saved config exists: hold the sensor 3 s to cancel setup
    static bool armed = false;
    static unsigned long heldSince = 0;
    bool touched = digitalRead(TOUCH_PIN) == TOUCH_ACTIVE;

    if (!touched) { armed = true; heldSince = 0; }
    else if (armed && cfgValid) {
      if (heldSince == 0) heldSince = millis();
      if (millis() - heldSince >= 3000 && restartAt == 0) {
        showMessage("Bye setup", "Restarting...", "", "", 3000);
        restartAt = millis() + 800;
      }
    }

    // Saved config exists and nobody is using setup: go back to normal
    if (cfgValid && restartAt == 0 && millis() - portalLastActivity >= PORTAL_IDLE_MS) {
      restartAt = millis();
    }

    if (screen == SCR_MESSAGE && timeReached(msgUntil)) screen = SCR_PORTAL;
    renderScreen();
    delay(2);
    return;
  }

  server.handleClient();
  if (mdnsStarted) MDNS.update();

  handleWiFi();
  handleTouch();
  updateTimers();
  handleNetTasks();
  renderScreen();

  delay(1);
}
