bool timeReached(unsigned long t) {
  return (long)(millis() - t) >= 0;
}

float easeTo(float v, float target, float k) {
  return v + (target - v) * k;
}

String fitText(const String& s, unsigned int maxChars) {
  if (s.length() <= maxChars) return s;
  return s.substring(0, maxChars - 1) + ".";
}

void drawCenteredText(const String& text, uint8_t size, int y) {
  int16_t x1, y1;
  uint16_t w, h;
  display.setTextSize(size);
  display.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
  display.setCursor((SCREEN_W - (int)w) / 2 - x1, y);
  display.print(text);
}

void thickLine(int x0, int y0, int x1, int y1) {
  display.drawLine(x0, y0, x1, y1, C_ON);
  display.drawLine(x0 + 1, y0, x1 + 1, y1, C_ON);
}

void drawHeart(int x, int y) {
  display.fillCircle(x - 2, y, 2, C_ON);
  display.fillCircle(x + 2, y, 2, C_ON);
  display.fillTriangle(x - 4, y + 1, x + 4, y + 1, x, y + 5, C_ON);
}

String jsonEscape(const String& s) {
  String out;
  out.reserve(s.length() + 4);
  for (unsigned int i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') { out += '\\'; out += c; }
    else if ((uint8_t)c < 0x20) {
      char buf[7];
      snprintf(buf, sizeof(buf), "\\u%04x", (uint8_t)c);
      out += buf;
    }
    else out += c;
  }
  return out;
}

String htmlEscape(const String& s) {
  String out;
  out.reserve(s.length() + 8);
  for (unsigned int i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '<') out += F("&lt;");
    else if (c == '>') out += F("&gt;");
    else if (c == '&') out += F("&amp;");
    else if (c == '"') out += F("&quot;");
    else out += c;
  }
  return out;
}

const char* moodName(Mood m) {
  switch (m) {
    case MOOD_HAPPY: return "happy";
    case MOOD_SAD:   return "sad";
    case MOOD_ANGRY: return "angry";
    default:         return "normal";
  }
}

const char* screenName(Screen s) {
  switch (s) {
    case SCR_TIME:    return "time";
    case SCR_WEATHER: return "weather";
    case SCR_MENU:    return "setup menu";
    case SCR_MESSAGE: return "message";
    case SCR_PORTAL:  return "setup";
    default:          return "eyes";
  }
}

String weatherText(int code) {
  if (code == 0) return "Clear";
  if (code == 1) return "Mostly clear";
  if (code == 2) return "Partly cloudy";
  if (code == 3) return "Cloudy";
  if (code == 45 || code == 48) return "Foggy";
  if (code >= 51 && code <= 57) return "Drizzle";
  if (code >= 61 && code <= 67) return "Rain";
  if (code >= 71 && code <= 77) return "Snow";
  if (code >= 80 && code <= 82) return "Showers";
  if (code >= 85 && code <= 86) return "Snow showers";
  if (code >= 95) return "Thunderstorm";
  return "Unknown";
}

bool getTimeNow(struct tm& t) {
  time_t now = time(nullptr);
  if (now < 1609459200) return false;   // before 2021 = not synced yet
  localtime_r(&now, &t);
  return true;
}


