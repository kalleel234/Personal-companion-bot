void drawCloud(int x, int y) {
  display.fillCircle(x - 7, y + 2, 6, C_ON);
  display.fillCircle(x + 1, y - 3, 8, C_ON);
  display.fillCircle(x + 9, y + 2, 6, C_ON);
  display.fillRect(x - 7, y + 2, 16, 7, C_ON);
}

void drawSun(int x, int y, int r) {
  display.fillCircle(x, y, r, C_ON);
  for (int i = 0; i < 8; i++) {
    float a = i * PI / 4.0f;
    display.drawLine(x + cosf(a) * (r + 3), y + sinf(a) * (r + 3),
                     x + cosf(a) * (r + 7), y + sinf(a) * (r + 7), C_ON);
  }
}

void drawMoon(int x, int y) {
  display.fillCircle(x, y, 9, C_ON);
  display.fillCircle(x + 5, y - 4, 8, C_OFF);
}

void drawWeatherIcon(int code, bool isDay, int x, int y) {
  if (code == 0 || code == 1) {
    if (isDay) drawSun(x, y, 7); else drawMoon(x, y);
  } else if (code == 2) {
    if (isDay) {
      drawSun(x + 6, y - 6, 5);
    } else {                                   // small moon above the cloud
      display.fillCircle(x + 10, y - 9, 5, C_ON);
      display.fillCircle(x + 13, y - 11, 4, C_OFF);
    }
    drawCloud(x - 3, y + 5);
  } else if (code == 45 || code == 48) {
    for (int i = 0; i < 4; i++) display.fillRect(x - 13 + (i % 2) * 4, y - 9 + i * 6, 24, 2, C_ON);
  } else if (code >= 71 && code <= 77) {
    drawCloud(x, y - 4);
    for (int i = 0; i < 3; i++) display.fillCircle(x - 8 + i * 8, y + 12, 1, C_ON);
  } else if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) {
    drawCloud(x, y - 4);
    for (int i = 0; i < 4; i++) display.drawLine(x - 10 + i * 6, y + 9, x - 12 + i * 6, y + 14, C_ON);
  } else if (code >= 95) {
    drawCloud(x, y - 4);
    display.fillTriangle(x + 1, y + 6, x - 4, y + 13, x + 1, y + 13, C_ON);
    display.fillTriangle(x - 1, y + 12, x + 4, y + 12, x - 2, y + 19, C_ON);
  } else {
    drawCloud(x, y);
  }
}

void drawPin(int x, int y) {
  display.fillCircle(x, y + 2, 2, C_ON);
  display.fillTriangle(x - 2, y + 3, x + 2, y + 3, x, y + 7, C_ON);
  display.drawPixel(x, y + 2, C_OFF);
}

// Where the weather is for: city name, or the coordinates if unknown
String placeText() {
  if (cityName.length()) return cityName;
  return String(wxLat, 2) + ", " + String(wxLon, 2);
}

void drawWeatherPage() {
  display.clearDisplay();
  display.setTextColor(C_ON);

  if (!weatherOk) {
    drawCenteredText("WEATHER", 1, 4);
    drawCenteredText(wifiUp ? "Loading..." : "Offline", 2, 24);
    drawCenteredText(wifiUp ? "please wait" : "No Wi-Fi", 1, 48);
    return;
  }

  drawWeatherIcon(wxCode, wxIsDay, 21, 20);

  // Temperature
  display.setTextSize(3);
  display.setCursor(46, 2);
  display.print((int)lroundf(wxTemp));
  int cx = display.getCursorX();
  display.drawCircle(cx + 3, 4, 2, C_ON);
  display.setTextSize(2);
  display.setCursor(cx + 8, 2);
  display.print("C");

  // Sky + humidity
  display.setTextSize(1);
  display.setCursor(46, 28);
  display.print(fitText(weatherText(wxCode), 13));

  display.setCursor(46, 39);
  display.print("Humidity ");
  display.print((int)lroundf(wxHum));
  display.print("%");

  // Location at the bottom
  display.drawFastHLine(0, 50, SCREEN_W, C_ON);

  String place = fitText(placeText(), wifiUp ? 19 : 13);
  if (!wifiUp) place += " (old)";   // last reading, Wi-Fi is down

  int textW = place.length() * 6;
  int x0 = (SCREEN_W - (textW + 9)) / 2;
  drawPin(x0 + 2, 54);
  display.setCursor(x0 + 9, 55);
  display.print(place);
}


