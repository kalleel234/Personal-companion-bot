float blinkFactor(unsigned long now) {
  if (blinkStart == 0) {
    if (!timeReached(nextBlinkAt)) return 1.0f;
    blinkStart = now;
  }

  unsigned long e = now - blinkStart;

  if (e >= BLINK_MS) {
    blinkStart = 0;
    if (doubleBlinkPending) {
      doubleBlinkPending = false;
      nextBlinkAt = now + 130;
    } else {
      nextBlinkAt = now + random(2500, 6000);
      doubleBlinkPending = random(100) < 20;
    }
    return 1.0f;
  }

  float p = e / (float)BLINK_MS;
  return p < 0.5f ? 1.0f - p * 2.0f : (p - 0.5f) * 2.0f;
}

void updateLookTarget(unsigned long now) {
  if (lookOverride) return;

  if (mood == MOOD_SAD)   { lookTX = 0; lookTY = 0.7f; return; }
  if (mood != MOOD_NORMAL) { lookTX = 0; lookTY = 0;   return; }

  if (!timeReached(nextLookAt)) return;

  if (random(100) < 45) {
    lookTX = 0;
    lookTY = 0;
  } else {
    const float xs[] = { -1.0f, -0.6f, 0.6f, 1.0f };
    const float ys[] = { -0.8f, 0.0f, 0.0f, 0.6f };
    lookTX = xs[random(4)];
    lookTY = ys[random(4)];
  }

  nextLookAt = now + random(1200, 3800);
}

// Female lashes on the outer top corner. side: -1 left eye, +1 right eye
void drawLashes(int ox, int ty, int side) {
  thickLine(ox - side * 1, ty + 8, ox + side * 6, ty + 4);
  thickLine(ox - side * 4, ty + 4, ox + side * 3, ty - 3);
  thickLine(ox - side * 9, ty + 1, ox - side * 5, ty - 6);
}

// Lashes sitting on a droopy (sad) lid. The lid rises toward the nose.
void drawSadLashes(int ox, int oy, int side, int d, int w) {
  int s3 = 3 * d / w;
  int s7 = 7 * d / w;
  thickLine(ox,            oy,      ox + side * 6, oy + 3);
  thickLine(ox - side * 3, oy - s3, ox + side * 4, oy - s3 - 3);
  thickLine(ox - side * 7, oy - s7, ox - side * 2, oy - s7 - 6);
}

// Eyelid edge: a line plus one pixel above it (keeps the iris clean)
void lidLine(int x0, int y0, int x1, int y1) {
  display.drawLine(x0, y0, x1, y1, C_ON);
  display.drawLine(x0, y0 - 1, x1, y1 - 1, C_ON);
}

void drawClosedEye(int left, int w, int cy, int outerX, int side) {
  display.fillRoundRect(left + 2, cy - 1, w - 4, 3, 1, C_ON);
  // sleepy lashes pointing down
  thickLine(outerX - side * 3, cy + 1, outerX + side * 2, cy + 6);
  thickLine(outerX - side * 9, cy + 1, outerX - side * 8, cy + 7);
}

void drawEye(int cx, int cy, int side, float openF, float wScale) {
  int w = (int)(EYE_W * wScale);
  int h = (int)(EYE_H * openF);

  int left   = cx - w / 2;
  int right  = left + w - 1;
  int outerX = (side < 0) ? left : right;
  int innerX = (side < 0) ? right : left;

  if (h < 6) {
    drawClosedEye(left, w, cy, outerX, side);
    return;
  }

  int top = cy - h / 2;

  int r = EYE_R;
  if (r > h / 2 - 1) r = h / 2 - 1;
  display.fillRoundRect(left, top, w, h, r, C_ON);

  // Iris with sparkles (hidden when smiling)
  if (happyV < 0.35f) {
    int ix = cx + (int)(lookX * 4);
    int iy = cy + 2 + (int)(lookY * 3);
    display.fillCircle(ix, iy, IRIS_R, C_OFF);

    if (openF > 0.6f) {
      int big = (sadV > 0.5f) ? 3 : 2;   // glossy, teary eyes when sad
      display.fillCircle(ix - 3, iy - 3, big, C_ON);
      display.fillCircle(ix + 3, iy + 4, 1, C_ON);
    }
  }

  int innerX2 = innerX - side * 2;   // a bit past the inner edge
  int outerX2 = outerX + side * 2;   // a bit past the outer edge

  // ANGRY: lids slant down toward the nose
  if (angryV > 0.02f) {
    int d = (int)(h * 0.5f * angryV);
    display.fillTriangle(innerX2, top - 2, outerX2, top - 2, innerX2, top + d, C_OFF);
    if (angryV > 0.3f) lidLine(innerX, top + d - 1, outerX, top - 1);
  }

  // SAD: lids droop on the outside
  int sadD = 0;
  if (sadV > 0.02f) {
    sadD = (int)(h * 0.5f * sadV);
    display.fillTriangle(outerX2, top - 2, innerX2, top - 2, outerX2, top + sadD, C_OFF);
    if (sadV > 0.3f) lidLine(outerX, top + sadD - 1, innerX, top - 1);
  }

  // HAPPY: cut the bottom with a big circle -> smiling arch  ^ ^
  if (happyV > 0.02f) {
    const int R = 22;
    int cutTop = top + (int)(h * 0.30f) + (int)((1.0f - happyV) * 40);
    display.fillCircle(cx, cutTop + R, R, C_OFF);
  }

  if (sadV > 0.5f) drawSadLashes(outerX, top + sadD - 1, side, sadD, w);
  else             drawLashes(outerX, top, side);
}

void drawBlush(int cx, int y, int side) {
  int bx = cx + side * 4 - 6;
  for (int i = 0; i < 3; i++) {
    display.drawLine(bx + i * 5, y + 4, bx + i * 5 + 3, y, C_ON);
  }
}

void drawTear(int x, int y) {
  display.fillCircle(x, y + 3, 2, C_ON);
  display.fillTriangle(x - 2, y + 3, x + 2, y + 3, x, y - 1, C_ON);
}

void drawAngerMark() {
  display.drawLine(119, 1, 119, 5, C_ON);  display.drawLine(119, 5, 115, 5, C_ON);
  display.drawLine(123, 1, 123, 5, C_ON);  display.drawLine(123, 5, 127, 5, C_ON);
  display.drawLine(119, 13, 119, 9, C_ON); display.drawLine(119, 9, 115, 9, C_ON);
  display.drawLine(123, 13, 123, 9, C_ON); display.drawLine(123, 9, 127, 9, C_ON);
}

// ---------------- MOUTH ----------------

// Smile (depth > 0) or frown (depth < 0), 2 px thick
void drawMouthCurve(int cx, int cy, int halfW, float depth) {
  for (int dx = -halfW; dx <= halfW; dx++) {
    float u = dx / (float)halfW;
    int y = cy + (int)lroundf(depth * (0.5f - u * u));
    display.drawFastVLine(cx + dx, y, 2, C_ON);
  }
}

// Big open smile: teeth on top, tongue at the bottom
void drawGrin(int cx, int top, int halfW, int h) {
  for (int dx = -halfW; dx <= halfW; dx++) {
    float u = dx / (float)halfW;
    int len = (int)lroundf(h * sqrtf(1.0f - u * u));
    if (len < 2) len = 2;
    display.drawFastVLine(cx + dx, top, len, C_ON);
  }

  int innerW = halfW - 3;
  for (int dx = -innerW; dx <= innerW; dx++) {
    float u = dx / (float)innerW;
    int len = (int)lroundf((h - 5) * sqrtf(1.0f - u * u));
    if (len > 0) display.drawFastVLine(cx + dx, top + 3, len, C_OFF);
  }

  if (h >= 10) display.fillCircle(cx, top + h - 4, 3, C_ON);   // tongue
}

// Angry: gritted teeth
void drawGrit(int cx, int cy) {
  display.fillRoundRect(cx - 12, cy - 4, 25, 9, 3, C_ON);
  display.drawFastHLine(cx - 10, cy, 21, C_OFF);
  for (int dx = -6; dx <= 6; dx += 6) {
    display.drawFastVLine(cx + dx, cy - 3, 7, C_OFF);
  }
}

void drawMouth(int cx, int cy, unsigned long now, float boop) {
  if (happyV > 0.5f) {
    drawGrin(cx, cy - 6, 14, (int)(13 * happyV));
  } else if (angryV > 0.5f) {
    drawGrit(cx, cy + 1);
  } else {
    // normal smile; bends into a frown when sad or getting angry
    float depth = 4.0f - 8.0f * sadV - 7.0f * angryV + 2.0f * boop;
    int halfW = 10 - (int)(2 * sadV) - (int)(2 * angryV);
    int wobble = (sadV > 0.7f) ? (int)lroundf(sinf(now * 0.02f)) : 0;   // trembling lip
    drawMouthCurve(cx + wobble, cy, halfW, depth);
  }
}

// Draws the face into the buffer (caller calls display.display())
void renderEyes(unsigned long now) {
  updateLookTarget(now);

  happyV = easeTo(happyV, mood == MOOD_HAPPY ? 1.0f : 0.0f, 0.25f);
  sadV   = easeTo(sadV,   mood == MOOD_SAD   ? 1.0f : 0.0f, 0.20f);
  angryV = easeTo(angryV, mood == MOOD_ANGRY ? 1.0f : 0.0f, 0.30f);
  lookX  = easeTo(lookX, lookTX, 0.22f);
  lookY  = easeTo(lookY, lookTY, 0.22f);

  float openF = blinkFactor(now);
  float wScale = 1.0f;
  float boop = 0.0f;

  // Wake-up: eyes open slowly after boot
  if (wakeStart != 0 && now - wakeStart < 700) {
    float p = (now - wakeStart) / 700.0f;
    openF *= p * p;
  }

  // Boop: squish on every tap
  if (boopStart != 0 && now - boopStart < BOOP_MS) {
    float s = sinf((now - boopStart) / (float)BOOP_MS * PI);
    boop = s;
    openF  *= 1.0f - 0.2f * s;
    wScale += 0.08f * s;
  }

  int ox = (int)(lookX * 6);
  int oy = (int)(lookY * 3);

  // Happy bounce
  if (happyV > 0.1f) {
    oy -= (int)(fabsf(sinf(now * 0.008f)) * 3.0f * happyV);
  }

  // Angry shake at the start
  if (mood == MOOD_ANGRY && now - moodStart < 700) {
    ox += (int)(sinf(now * 0.09f) * 2.0f);
  }

  display.clearDisplay();

  drawEye(LEFT_CX + ox,  EYE_CY + oy, -1, openF, wScale);
  drawEye(RIGHT_CX + ox, EYE_CY + oy, +1, openF, wScale);

  if (showMouth) drawMouth(MOUTH_X + ox / 2, MOUTH_Y + oy / 2, now, boop);

  if (happyV > 0.6f) {
    drawBlush(LEFT_CX + ox,  EYE_CY + 11 + oy, -1);
    drawBlush(RIGHT_CX + ox, EYE_CY + 11 + oy, +1);

    float phase = (now % 1600) / 1600.0f;
    drawHeart(64, 38 - (int)(phase * 38));   // floats up between the eyes
  }

  if (sadV > 0.7f) {
    int bottom = EYE_CY + oy + EYE_H / 2;
    drawTear(RIGHT_CX + ox + 11, bottom + (int)((now / 28) % 22));
    drawTear(LEFT_CX + ox - 11,  bottom + (int)(((now + 300) / 28) % 22));
  }

  if (angryV > 0.7f && (now / 300) % 2 == 0) {
    drawAngerMark();
  }
}


