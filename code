// Thin line along the bottom that fills up while the sensor is held
void drawHoldBar(unsigned long now) {
  if (!touchState || screen == SCR_PORTAL || restartAt != 0) return;

  unsigned long held = now - pressStart;
  unsigned long part = 0, full = HOLD_INFO_MS;

  if (screen == SCR_MENU) {
    if (!menuArmed || menuHoldFired) return;
    part = held;                              // 0..3 sec -> change Wi-Fi
    full = MENU_WIFI_HOLD_MS;
  } else if (longFired) {
    part = held - HOLD_INFO_MS;               // 5..10 sec -> setup menu
    full = HOLD_MENU_MS - HOLD_INFO_MS;
  } else if (screen == SCR_EYES) {
    part = held;                              // 0..5 sec -> time & date
  } else {
    return;
  }

  if (held < 600) return;
  if (part > full) part = full;
  display.drawFastHLine(0, SCREEN_H - 1, (int)(part * SCREEN_W / full), C_ON);
}

void renderScreen() {
  unsigned long now = millis();
  unsigned long interval = (screen == SCR_EYES) ? FRAME_EYES_MS : FRAME_INFO_MS;
  if (touchState && interval > 100) interval = 100;   // smooth hold bar
  if (lastFrame != 0 && now - lastFrame < interval) return;
  lastFrame = now;

  switch (screen) {
    case SCR_EYES:    renderEyes(now);   break;
    case SCR_TIME:    drawTimePage();    break;
    case SCR_WEATHER: drawWeatherPage(); break;
    case SCR_MENU:    drawMenuPage();    break;
    case SCR_MESSAGE: drawMessagePage(); break;
    case SCR_PORTAL:  drawPortalPage();  break;
  }

  drawHoldBar(now);
  display.display();
}


