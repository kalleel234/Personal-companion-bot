const char* DAY_NAMES[]   = { "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY",
                              "THURSDAY", "FRIDAY", "SATURDAY" };
const char* MONTH_NAMES[] = { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                              "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

void drawTimePage() {
  display.clearDisplay();
  display.setTextColor(C_ON);

  struct tm t;

  if (!getTimeNow(t)) {
    drawCenteredText("TIME", 1, 4);
    drawCenteredText("Not synced yet", 1, 26);
    drawCenteredText(wifiUp ? "Asking internet..." : "No Wi-Fi", 1, 40);
    return;
  }

  int h12 = t.tm_hour % 12;
  if (h12 == 0) h12 = 12;

  char hhmm[8];
  snprintf(hhmm, sizeof(hhmm), (t.tm_sec % 2) ? "%d %02d" : "%d:%02d", h12, t.tm_min);
  const char* ampm = t.tm_hour < 12 ? "AM" : "PM";

  int16_t x1, y1;
  uint16_t tw, th;
  display.setTextSize(3);
  display.getTextBounds(hhmm, 0, 0, &x1, &y1, &tw, &th);

  int total = tw + 3 + 12;
  int x0 = (SCREEN_W - total) / 2;

  display.setCursor(x0, 20);
  display.print(hhmm);

  display.setTextSize(1);
  display.setCursor(x0 + tw + 3, 20);
  display.print(ampm);

  drawCenteredText(DAY_NAMES[t.tm_wday], 1, 3);

  char date[20];
  snprintf(date, sizeof(date), "%d %s %d",
           t.tm_mday, MONTH_NAMES[t.tm_mon], t.tm_year + 1900);
  drawCenteredText(date, 1, 53);

  drawHeart(6, 5);
  drawHeart(121, 5);
}


